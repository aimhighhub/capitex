# Copy this file's contents into Vercel → your project → Settings → Environment Variables.
# Never commit a real .env file — this is a template only.

# ---- Supabase (Settings → API in your Supabase project) ----
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # server-side only — used by /api routes, never in index.html

# ---- Stripe (Developers → API keys) ----
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...       # from Developers → Webhooks, after you register the endpoint

# ---- Site URL (used for Stripe redirect URLs) ----
PUBLIC_SITE_URL=https://your-domain.vercel.app

# Note: the anon (public) Supabase key and URL go directly in index.html's
# LO_CONFIG object near the top of the <script> block — that key is safe to
# expose client-side by design (Supabase enforces access via Row Level
# Security policies, already defined in supabase/schema.sql).
